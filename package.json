    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/node": "latest",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "opencode",
    "plugin",
    "my-commands"
  ],
  "license": "MIT"
