{
  "name": "my-commands",
  "version": "0.1.0",
  "description": "Custom slash commands plugin for OpenCode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "commands",
    ".opencode"
  ],
  "scripts": {
